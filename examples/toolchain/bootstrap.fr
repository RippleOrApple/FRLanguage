    {
      "path": "fr_parser_control_flow_sample.fr.txt",
      "output": ["14"],
      "errors": []
    },
    {
      "path": "fr_parser_function_sample.fr.txt",
      "output": ["7", "yes", "no", "120"],
      "errors": []
    },
    {
      "path": "fr_parser_scope_sample.fr.txt",
      "output": ["inner", "outer", "15"],
      "errors": []
    },
    {
      "path": "fr_parser_logic_sample.fr.txt",
      "output": ["true", "0", "false", "0", "fallback", "done", "2"],
      "errors": []
    },
    {
      "path": "fr_parser_break_sample.fr.txt",
      "output": ["4", "6", "2"],
      "errors": []
    },
    {
      "path": "fr_parser_future_sample.fr.txt",
      "output": ["0", "41", "1", "41"],
      "errors": []
    },
    {
      "path": "fr_parser_future_reject_sample.fr.txt",
      "output": ["before"],
      "errors": ["变量 missing 未定义"]
    },
    {
      "path": "fr_parser_builtins_sample.fr.txt",
      "output": ["2", "3", "[1, 2, 3]", "3", "[1, 2]", "true", "false", "map", "42!", "FR", "R", "true"],
      "errors": []
    },
    {
      "path": "fr_parser_import_sample.fr.txt",
      "output": ["1", "5"],
      "errors": []
    },
    {
      "path": "fr_parser_error_sample.fr.txt",
      "output": [],
      "errors": ["变量 missing 未定义"]
    },
    {
      "path": "fr_parser_call_error_sample.fr.txt",
      "output": [],
      "errors": ["只能调用函数"]
    },
    {
      "path": "fr_parser_await_error_sample.fr.txt",
      "output": [],
      "errors": ["await 只能用于 Future"]
    },
    {
      "path": "fr_parser_top_level_return_error_sample.fr.txt",
      "output": [],
      "errors": ["return 只能用于函数"]
    },
    {
      "path": "fr_parser_top_level_break_error_sample.fr.txt",
      "output": [],
      "errors": ["break 只能用于 while 循环"]
    },
    {
      "path": "fr_parser_function_break_error_sample.fr.txt",
      "output": [],
      "errors": ["break 只能用于 while 循环"]
    },
    {
      "path": "fr_parser_future_break_error_sample.fr.txt",
      "output": [],
      "errors": ["break 只能用于 while 循环"]
    }
  ];
}

// 运行默认自举验收用例，并返回总结果。
fn runDefaultBootstrapExpectations() {
  return runBootstrapExpectations(defaultBootstrapExpectations());
}
