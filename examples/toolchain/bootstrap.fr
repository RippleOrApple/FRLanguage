import "lexer.fr";
import "parser.fr";
import "interpreter.fr";

// 运行一个自举样例文件，并返回路径、输出和错误诊断。
fn runBootstrapCase(path) {
  let result = runSelfHostedFileResult(path);
  return {
    "path": path,
    "output": result["output"],
    "errors": result["errors"]
  };
}

// 运行一组自举样例文件，并返回结构化结果列表。
fn runBootstrapSuite(paths) {
  let results = [];
  let index = 0;
  while index < len(paths) {
    push(results, runBootstrapCase(paths[index]));
    index = index + 1;
  }
  return results;
}

// 从错误对象列表中提取 message，便于和期望错误做结构化对照。
fn bootstrapErrorMessages(errors) {
  let messages = [];
  let index = 0;
  while index < len(errors) {
    push(messages, errors[index]["message"]);
    index = index + 1;
  }
  return messages;
}

// 运行一个带 expected 的自举用例，并判断输出和错误是否匹配。
fn runBootstrapExpectation(expectation) {
  let result = runBootstrapCase(expectation["path"]);
  let errorMessages = bootstrapErrorMessages(result["errors"]);
  let outputPassed = result["output"] == expectation["output"];
  let errorsPassed = errorMessages == expectation["errors"];
  return {
    "path": expectation["path"],
    "passed": outputPassed and errorsPassed,
    "output": result["output"],
    "errors": errorMessages,
    "expected_output": expectation["output"],
    "expected_errors": expectation["errors"]
  };
}

// 运行一组带 expected 的自举用例，并返回总结果和每个用例结果。
fn runBootstrapExpectations(expectations) {
  let cases = [];
  let passed = true;
  let passedCount = 0;
  let failedCount = 0;
  let index = 0;
  while index < len(expectations) {
    let result = runBootstrapExpectation(expectations[index]);
    if !result["passed"] {
      passed = false;
      failedCount = failedCount + 1;
    } else {
      passedCount = passedCount + 1;
    }
    push(cases, result);
    index = index + 1;
  }
  return {
    "passed": passed,
    "case_count": len(cases),
    "passed_count": passedCount,
    "failed_count": failedCount,
    "cases": cases
  };
}

// 返回默认自举验收用例，覆盖正常路径和基础错误路径。
