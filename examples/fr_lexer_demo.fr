import "fr_lexer_helpers.fr";

// 扫描一段源码字符串，返回简化 Token 列表。
fn scan(source) {
  let tokens = [];
  let current = 0;

  while current < len(source) {
    let ch = charAt(source, current);

    if ch == " " {
      current = current + 1;
    } else {
      if ch == ";" {
        addToken(tokens, "SEMICOLON", ch);
        current = current + 1;
      } else {
        if ch == "=" {
          addToken(tokens, "EQUAL", ch);
          current = current + 1;
        } else {
          if isDigit(ch) {
            let start = current;
            while current < len(source) {
              let digit = charAt(source, current);
              if isDigit(digit) {
                current = current + 1;
              } else {
                break;
              }
            }
            addToken(tokens, "NUMBER", substring(source, start, current));
          } else {
            let start = current;
            while current < len(source) {
              let part = charAt(source, current);
              if part == " " or part == "=" or part == ";" {
                break;
              } else {
                current = current + 1;
              }
            }
            if start < current {
              addToken(tokens, "IDENT", substring(source, start, current));
            }
          }
        }
      }
    }
  }

  addToken(tokens, "EOF", "");
  return tokens;
}

print(scan("let answer = 42;"));
