import "fr_lexer_helpers.fr";

// 扫描一段源码字符串，返回简化 Token 列表。
fn scan(source) {
  let tokens = [];
  let current = 0;

  while current < len(source) {
    let ch = charAt(source, current);

    if isWhitespace(ch) {
      current = current + 1;
    } else {
      if ch == "/" and peekNext(source, current) == "/" {
        current = skipLineComment(source, current + 2);
      } else {
        if isQuote(ch) {
          current = scanString(source, tokens, current);
        } else {
          if isDigit(ch) {
            current = scanNumber(source, tokens, current);
          } else {
            if isAlpha(ch) {
              current = scanIdentifier(source, tokens, current);
            } else {
              let pairType = pairTokenType(source, current);
              if pairType != "" {
                addToken(tokens, pairType, substring(source, current, current + 2));
                current = current + 2;
              } else {
                let singleType = singleCharTokenType(ch);
                if singleType != "" {
                  addToken(tokens, singleType, ch);
                }
                current = current + 1;
              }
            }
          }
        }
      }
    }
  }

  addToken(tokens, "EOF", "");
  return tokens;
}

print(scan(readFile("fr_lexer_sample.fr.txt")));
